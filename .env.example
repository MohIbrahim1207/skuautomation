# =========================================================================
# Flow Force Enterprise SKU & PR Automation - Environment Configuration
# Copy this file to .env and configure values before starting containers
# =========================================================================

# Application Environment
NODE_ENV=production
PORT=3000

# Security / Authentication
JWT_SECRET=replace_with_a_secure_random_jwt_secret_in_production

# Persistent File Storage
STORAGE_DIR=./storage

# PostgreSQL Configuration
POSTGRES_DB=flow_force
POSTGRES_USER=flowforce_user
POSTGRES_PASSWORD=flowforce_secure_password

# Database Connection URL
# Inside Docker (app connects to the 'postgres' container hostname):
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# For Local Development outside Docker (uncomment if running on host):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flow_force
